{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "noUnusedLocals": true,
    "noUnusedParameters": false
  },
  "include": ["index.ts", "src/**/*.ts", "test/**/*.ts"]
}
